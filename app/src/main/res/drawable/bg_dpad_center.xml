<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/action_blue_pressed" />
            <stroke android:width="2dp" android:color="@color/bios_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/action_blue" />
            <stroke android:width="2dp" android:color="@color/bios_cyan" />
        </shape>
    </item>
</selector>
