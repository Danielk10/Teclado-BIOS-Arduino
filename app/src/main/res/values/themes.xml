<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TecladoBIOS" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/bios_cyan</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="buttonStyle">@style/BiosKeyButton</item>
        <item name="android:buttonStyle">@style/BiosKeyButton</item>
    </style>

    <style name="Theme.TecladoBIOS.Fullscreen" parent="Theme.TecladoBIOS">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="BiosKeyButton" parent="android:Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_key_standard</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">8.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:paddingHorizontal">1dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">0.85</item>
    </style>

    <style name="BiosKeyButton.Alert">
        <item name="android:background">@drawable/bg_key_bios_alert</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="BiosKeyButton.Action">
        <item name="android:background">@drawable/bg_key_action</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="KeyboardKey" parent="android:Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:background">@drawable/bg_key_standard</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TerminalSendButton" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_key_action</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">54dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="MouseButton" parent="android:Widget.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">0.85</item>
    </style>

    <style name="HeaderButton" parent="android:Widget.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
